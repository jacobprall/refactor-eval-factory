{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"app/**",
			"eval/**",
			"scripts/**",
			"tests/**",
			"factory.config.ts",
			"!eval/targets/commerce/**"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 150
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}
