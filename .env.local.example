RENDER_USE_LOCAL_DEV=true
RENDER_LOCAL_DEV_URL=http://localhost:8120

# Remote Render Sandboxes still require workspace credentials.
RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# Spend-capped model key; passed only to the hardened runner in each Sandbox.
ANTHROPIC_API_KEY=

# Local Postgres from compose.yaml.
DATABASE_URL=postgresql://refactor_eval:refactor_eval@localhost:54329/refactor_eval
