# `npm run setup:render` copies these values into the Render env groups render.yaml links; see
# docs/configuration.md#environment-groups.

# Render API key and workspace used by evaluation tasks to manage remote Sandboxes.
RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# Model provider key. Use a spend-capped key: it enters the sandbox only for agent runs.
ANTHROPIC_API_KEY=

# Postgres is wired by render.yaml in production. Set this for local runs, or to the database's external URL for analysis.
DATABASE_URL=postgresql://refactor_eval:refactor_eval@localhost:54329/refactor_eval

# Slug of the deployed Workflows service; `npm run eval` starts tasks as <slug>/<task>.
RENDER_WORKFLOW_SLUG=refactor-eval-workflows

# Legacy GitHub issue-to-PR workflow configuration. Evaluation tasks do not use these values.
PORT=3000
# Secret configured on the GitHub App's webhook.
GITHUB_WEBHOOK_SECRET=

# GitHub App credentials; the installation comes from each webhook.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional: GitHub API base URL, for GitHub Enterprise Server.
GITHUB_API_URL=
